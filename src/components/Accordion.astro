---
// src/components/Accordion.astro
interface ModuleItem {
  week: string;
  title: string;
  description: string;
  skills: string[];
}

interface Props {
  modules: ModuleItem[];
}

const { modules } = Astro.props;
---

<div class="w-full space-y-4">
  {modules.map((item) => (
    <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden transition-all duration-200">
      <summary class="flex items-center justify-between p-5 cursor-pointer list-none bg-white hover:bg-slate-50 transition-colors select-none">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-left">
          <span class="inline-block px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 rounded-md whitespace-nowrap">
            {item.week}
          </span>
          <h4 class="text-base font-bold text-slate-900 leading-snug">
            {item.title}
          </h4>
        </div>
        <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>

      <div class="px-5 pb-5 border-t border-slate-100 bg-slate-50/40 text-left">
        <p class="text-slate-600 text-sm leading-relaxed pt-4 whitespace-pre-line">
          {item.description}
        </p>
        
        {item.skills && item.skills.length > 0 && (
          <div class="mt-4 pt-3 border-t border-slate-100">
            <h5 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Fokus i alati:</h5>
            <div class="flex flex-wrap gap-1.5">
              {item.skills.map((skill) => (
                <span class="inline-block text-xs font-medium text-slate-700 bg-white border border-slate-200 px-2.5 py-0.5 rounded-md shadow-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>