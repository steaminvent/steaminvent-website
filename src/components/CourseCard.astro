---
// src/components/CourseCard.astro
import type { Course } from '../data/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group">
  
  <!-- Slika kursa sa bedžom kategorije -->
  <div class="relative aspect-video w-full overflow-hidden bg-slate-100">
    <img 
      src={course.image} 
      alt={course.title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent"></div>
    <span class="absolute top-4 left-4 bg-indigo-600 text-white text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
      {course.category}
    </span>
  </div>

  <!-- Sadržaj kartice -->
  <div class="p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md">
          {course.difficulty}
        </span>
        <span class="text-xs text-slate-500 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {course.duration}
        </span>
      </div>

      <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors duration-200">
        {course.title}
      </h3>
      
      <p class="text-slate-600 text-sm leading-relaxed line-clamp-3 mb-4">
        {course.description}
      </p>
    </div>

    <!-- Tehnologije i akciono dugme -->
    <div class="mt-4">
      <div class="flex flex-wrap gap-1.5 mb-6">
        {course.technologies.slice(0, 3).map((tech) => (
          <span class="text-[11px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
            #{tech}
          </span>
        ))}
      </div>

      <a 
        href={`/courses/${course.slug}`} 
        class="block text-center bg-slate-950 text-white hover:bg-indigo-600 font-semibold py-2.5 px-4 rounded-xl transition-colors duration-200 text-sm shadow-sm"
      >
        Saznaj više o kursu
      </a>
    </div>
  </div>
</div>