---
// src/components/FeatureCard.astro
interface Props {
  title: string;
  description: string;
  iconPath: string; // Putanja do velike PNG ilustracije iz public foldera
  badgeText?: string;
}

const { title, description, iconPath, badgeText } = Astro.props;
---

<div class="bg-white border border-slate-200/70 rounded-2xl flex flex-col justify-between hover:border-indigo-500 hover:shadow-2xl transition-all duration-300 shadow-lg overflow-hidden h-full w-full group">
  <div>
    <!-- Velika, dominantna slika koja ide od ivice do ivice na vrhu kartice -->
    <div class="w-full aspect-[16/10] bg-slate-950 overflow-hidden border-b border-slate-100 relative">
      <img 
        src={iconPath} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
      />
      {badgeText && (
        <span class="absolute top-3 left-3 text-[10px] font-bold uppercase tracking-wider bg-indigo-600 text-white px-2.5 py-1 rounded-full shadow-md z-10">
          {badgeText}
        </span>
      )}
    </div>
    
    <!-- Tekstualni sadržaj sa sopstvenim razmakom -->
    <div class="p-6">
      <h3 class="text-xl font-black text-slate-950 mb-3 tracking-tight">
        {title}
      </h3>
      <p class="text-slate-600 text-sm leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</div>