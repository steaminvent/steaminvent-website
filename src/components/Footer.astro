---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800 pt-16 pb-8">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
        
        <!-- KOLONA 1: O UDRUŽENJU & ZVANIČNI PODACI -->
        <div class="space-y-4 text-left">
            <div class="flex items-center gap-3">
                <img 
                    src="/images/logo.png" 
                    alt="STEAM INVENT mali logo" 
                    class="w-10 h-10 object-contain"
                />
                <span class="text-lg font-black tracking-tight text-white">STEAM INVENT</span>
            </div>
    
            <div class="text-[11px] text-slate-500 space-y-1.5 pt-3 border-t border-slate-800">
                <p><span class="font-semibold text-slate-400">Naziv:</span> Udruženje za promociju STEAM disciplina i inovacija "STEAM INVENT"</p>
                <p><span class="font-semibold text-slate-400">Pravni status:</span> Udruženje</p>
                <p><span class="font-semibold text-slate-400">Sedište:</span> Sremska Mitrovica, Srbija</p>
                <p><span class="font-semibold text-slate-400">PIB:</span> 115913747</p>
                <p><span class="font-semibold text-slate-400">MB:</span> 28420625</p>
            </div>
        </div>

        <!-- KOLONA 2: BRZI LINKOVI -->
        <div class="space-y-4 text-left lg:pl-6">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">Navigacija</h3>
            <ul class="space-y-2.5 text-xs">
                <li><a href="/" class="hover:text-indigo-400 transition-colors">Početna stranica</a></li>
                <li><a href="/courses" class="hover:text-indigo-400 transition-colors">Katalog programa</a></li>
                <li><a href="/activities" class="hover:text-indigo-400 transition-colors">Naše aktivnosti</a></li>
                <li><a href="/about" class="hover:text-indigo-400 transition-colors">O nama i timu</a></li>
                <li><a href="/contact" class="hover:text-indigo-400 transition-colors">Kontakt i upis</a></li>
            </ul>
        </div>

        <!-- KOLONA 3: DRUŠTVENE MREŽE & KONTAKT -->
        <div class="space-y-4 text-left">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">Povežite se sa nama</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Pratite naše radionice i projekte uživo preko društvenih mreža:</p>
            
            <div class="flex items-center gap-3 pt-1">
                <!-- Facebook -->
                <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 flex items-center justify-center hover:bg-indigo-600 hover:text-white transition-all duration-200" aria-label="Facebook">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.8z"/>
                    </svg>
                </a>
                <!-- Instagram -->
                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 flex items-center justify-center hover:bg-pink-600 hover:text-white transition-all duration-200" aria-label="Instagram">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                </a>
                <!-- LinkedIn -->
                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all duration-200" aria-label="LinkedIn">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                </a>
            </div>

            <div class="pt-2 space-y-3">
                <div>
                    <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Direktan email:</h4>
                    <a href="mailto:info@steaminvent.org" class="text-xs text-slate-300 hover:text-indigo-400 transition-colors">info@steaminvent.org</a>
                </div>
                
                <div>
                    <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Kontakt telefoni:</h4>
                    <div class="flex flex-col space-y-1">
                        <a href="tel:+381677427415" class="text-xs text-slate-300 hover:text-indigo-400 transition-colors">067 / 742-74-15</a>
                        <a href="tel:+381643686692" class="text-xs text-slate-300 hover:text-indigo-400 transition-colors">064 / 368-66-92</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- KOLONA 4: INTERAKTIVNA MAPA -->
        <div class="space-y-4 text-left">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">Gde se nalazimo</h3>
            <div class="relative w-full h-40 rounded-xl overflow-hidden border border-slate-800 shadow-inner bg-slate-950 group/map">
                <!-- Lebdeći bedž -->
                <div class="absolute top-2.5 left-2.5 z-10 bg-slate-900/90 backdrop-blur-sm border border-slate-700/50 px-2.5 py-1 rounded-lg flex items-center gap-1.5 shadow-lg pointer-events-none group-hover/map:border-indigo-500/50 transition-colors duration-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
                    <span class="text-[10px] font-bold text-white tracking-wide">STEAM INVENT</span>
                </div>

                <!-- Google Maps Embed -->
                <iframe
                    src="https://maps.google.com/maps?q=44.9694269,19.6067545&t=&z=16&ie=UTF8&iwloc=B&output=embed"
                    class="w-full h-full border-0 grayscale opacity-75 contrast-125 group-hover/map:opacity-100 group-hover/map:grayscale-0 transition-all duration-300"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
        </div>

    </div>

    <!-- DONJA TRAKA -->
    <div class="max-w-6xl mx-auto px-4 pt-8 border-t border-slate-800 text-center md:flex md:justify-between md:text-left text-xs text-slate-500">
        <p>&copy; {currentYear} STEAM INVENT Sremska Mitrovica. Sva prava zadržana.</p>
        <p class="mt-1 md:mt-0 text-[11px]">Udruženje građana osnovano sa ciljem razvoja nauke i tehnologije.</p>
    </div>
</footer>