---
// src/layouts/MainLayout.astro
import "../styles/global.css"; // Uvozimo globalne Tailwind stilove
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "STEAM INVENT - Nauka, Tehnologija, Inženjerstvo, Umetnost i Matematika",
  description = "Udruženje građana iz Sremske Mitrovice posvećeno razvoju digitalnih veština, robotike i hardverske automatizacije kod dece i mladih.",
} = Astro.props;

// Čitamo trenutnu putanju iz URL-a (npr. "/" ili "/courses")
const pathname = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon koji direktno koristi SVG ikonice čipa iz headera -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg viewBox='0 0 40 40' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='6' y='6' width='28' height='28' rx='7' fill='%23EEF2FF' stroke='%234F46E5' stroke-width='2.5'/%3E%3Cpath d='M14 2V6M20 2V6M26 2V6' stroke='%236366F1' stroke-width='2' stroke-linecap='round'/%3E%3Cpath d='M14 34V38M20 34V38M26 34V38' stroke='%236366F1' stroke-width='2' stroke-linecap='round'/%3E%3Cpath d='M2 14H6M2 20H6M2 26H6' stroke='%236366F1' stroke-width='2' stroke-linecap='round'/%3E%3Cpath d='M34 14H38M34 20H38M34 26H38' stroke='%236366F1' stroke-width='2' stroke-linecap='round'/%3E%3Cpath d='M13 14H25C26.6569 14 28 15.3431 28 17C28 18.6569 26.6569 20 25 20H15C13.3431 20 12 21.3431 12 23C12 24.6569 13.3431 26 15 26H27' stroke='%234F46E5' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='13' cy='14' r='2' fill='%2306B6D4'/%3E%3Ccircle cx='27' cy='26' r='2' fill='%2306B6D4'/%3E%3C/svg%3E" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primarni SEO tagovi -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
  </head>

  <body
    class="bg-slate-50 text-slate-950 min-h-screen flex flex-col justify-between font-sans antialiased"
  >
    <!-- Glavna navigacija (Header) -->
    <header
      class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50"
    >
      <div
        class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center"
      >
        <!-- Logotip udruženja: Inženjerski čip sa PCB trasom i konektorima -->
        <a
          href="/"
          class="flex items-center gap-3 text-2xl font-black tracking-wider text-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-md group z-50"
        >
          <svg
            class="w-10 h-10 group-hover:scale-105 transition-transform duration-300"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Okvir čipa / Kućište -->
            <rect x="6" y="6" width="28" height="28" rx="7" fill="#EEF2FF" stroke="#4F46E5" stroke-width="2.5" />
            
            <!-- Pinovi / Konektori mikrokontrolera -->
            <path d="M14 2V6M20 2V6M26 2V6" stroke="#6366F1" stroke-width="2" stroke-linecap="round"/>
            <path d="M14 34V38M20 34V38M26 34V38" stroke="#6366F1" stroke-width="2" stroke-linecap="round"/>
            <path d="M2 14H6M2 20H6M2 26H6" stroke="#6366F1" stroke-width="2" stroke-linecap="round"/>
            <path d="M34 14H38M34 20H38M34 26H38" stroke="#6366F1" stroke-width="2" stroke-linecap="round"/>

            <!-- S-stilizovana PCB trasa (Slovo S od STEAM) -->
            <path d="M13 14H25C26.6569 14 28 15.3431 28 17C28 18.6569 26.6569 20 25 20H15C13.3431 20 12 21.3431 12 23C12 24.6569 13.3431 26 15 26H27" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>

            <!-- Čvorovi / Pinovi na trasama (Inovacija / Podaci) -->
            <circle cx="13" cy="14" r="2" fill="#06B6D4" />
            <circle cx="27" cy="26" r="2" fill="#06B6D4" />
          </svg>

          <span
            class="text-slate-900 group-hover:text-indigo-600 transition-colors duration-200"
          >
            STEAM <span class="text-indigo-600">INVENT</span>
          </span>
        </a>

        <!-- DESKTOP NAVIGACIJA -->
        <nav class="hidden md:flex space-x-6 font-semibold">
          <a
            href="/"
            class={pathname === "/"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Početna
          </a>
          <a
            href="/courses"
            class={pathname.startsWith("/courses")
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Programi
          </a>
          <a 
            href="/activities"
            class={pathname.startsWith("/activities")
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Aktivnosti
          </a>
          <a
            href="/about"
            class={pathname === "/about"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            O nama
          </a>
          <a
            href="/contact"
            class={pathname === "/contact"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Kontakt
          </a>
        </nav>

        <!-- DUGME: HAMBURGER TRI CRTICE -->
        <button 
          id="menu-btn" 
          class="block md:hidden p-2 text-slate-600 hover:text-indigo-600 focus:outline-none z-50"
          aria-label="Meni"
        >
          <svg id="menu-icon" class="w-7 h-7 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>
    </header>

    <!-- PANEL ZA MOBILNI MENI -->
    <div 
      id="steaminvent-mobilni-meni" 
      style="display: none; background-color: #ffffff; flex-direction: column;"
      class="fixed inset-0 z-[100] pt-28 px-6 space-y-5 md:hidden"
    >
      <a
        href="/"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/" ? "text-indigo-600" : "text-slate-700"}`}
      >
        Početna
      </a>
      <a
        href="/courses"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname.startsWith("/courses") ? "text-indigo-600" : "text-slate-700"}`}
      >
        Programi
      </a>
      <a 
        href="/activities"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname.startsWith("/activities") ? "text-indigo-600" : "text-slate-700"}`}
      >
        Aktivnosti
      </a>
      <a
        href="/about"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/about" ? "text-indigo-600" : "text-slate-700"}`}
      >
        O nama
      </a>
      <a
        href="/contact"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/contact" ? "text-indigo-600" : "text-slate-700"}`}
      >
        Kontakt
      </a>
    </div>

    <!-- Glavni sadržaj stranica -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Globalno podnožje (Footer) -->
    <Footer />

    <!-- SKRIPT ZA KONTROLU MOBILNOG MENIJA -->
    <script is:inline>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('steaminvent-mobilni-meni');
      const menuIcon = document.getElementById('menu-icon');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function toggleMenu() {
        if (mobileMenu.style.display === 'none') {
          mobileMenu.style.setProperty('display', 'flex', 'important');
          mobileMenu.style.setProperty('background-color', '#ffffff', 'important');
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />';
          document.body.classList.add('overflow-hidden');
        } else {
          mobileMenu.style.display = 'none';
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
          document.body.classList.remove('overflow-hidden');
        }
      }

      menuBtn.addEventListener('click', toggleMenu);

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.style.display = 'none';
          document.body.classList.remove('overflow-hidden');
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
        });
      });
    </script>
  </body>
</html>