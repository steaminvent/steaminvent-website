---
// src/layouts/MainLayout.astro
import "../styles/global.css"; // Uvozimo globalne Tailwind stilove
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "STEAM INVENT - Nauka, Tehnologija, Inženjerstvo, Umetnost i Matematika",
  description = "Udruženje građana iz Sremske Mitrovice posvećeno razvoju digitalnih veština, robotike i hardverske automatizacije kod dece i mladih.",
} = Astro.props;

// Čitamo trenutnu putanju stranice
const pathname = Astro.url.pathname;

// Canonical URL bez query parametara i sa završnim slash-om
const canonicalPath =
  pathname === "/"
    ? "/"
    : pathname.endsWith("/")
      ? pathname
      : `${pathname}/`;

const canonicalURL = `https://steaminvent.org${canonicalPath}`;

// Podrazumevana slika za deljenje na društvenim mrežama
const socialImage = "https://steaminvent.org/images/hero-background.png";
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/images/logo.png" />

    <meta name="generator" content={Astro.generator} />

    <!-- ========================================= -->
    <!-- PRIMARY SEO -->
    <!-- ========================================= -->

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- CANONICAL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- ========================================= -->
    <!-- OPEN GRAPH / FACEBOOK / SOCIAL SHARING -->
    <!-- ========================================= -->

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="STEAM INVENT" />
    <meta property="og:locale" content="sr_RS" />

    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="STEAM INVENT - Udruženje za promociju STEAM disciplina i inovacija"
    />

    <!-- ========================================= -->
    <!-- TWITTER / X -->
    <!-- ========================================= -->

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="STEAM INVENT - Udruženje za promociju STEAM disciplina i inovacija"
    />

    <!-- ========================================= -->
    <!-- ORGANIZATION STRUCTURED DATA / JSON-LD -->
    <!-- ========================================= -->

    {pathname === "/" && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": "https://steaminvent.org/#organization",
          "name": "STEAM INVENT",
          "legalName": "Udruženje za promociju STEAM disciplina i inovacija \"STEAM INVENT\"",
          "url": "https://steaminvent.org/",
          "logo": "https://steaminvent.org/images/logo.png",
          "description": "Udruženje za promociju STEAM disciplina i inovacija koje kroz obrazovne programe, radionice i projekte povezuje nauku, tehnologiju, inženjerstvo, umetnost i matematiku.",
          "email": "info@steaminvent.org",
          "telephone": [
            "+381677427415",
            "+381643686692"
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Kralja Petra I 5/12",
            "postalCode": "22000",
            "addressLocality": "Sremska Mitrovica",
            "addressCountry": "RS"
          },
          "sameAs": [
            "https://www.facebook.com/steaminvent.sm/",
            "https://www.instagram.com/steaminvent.sm/"
          ],
          "taxID": "115913747"
        })}
      />
    )}
  </head>

  <body
    class="bg-slate-50 text-slate-950 min-h-screen flex flex-col justify-between font-sans antialiased"
  >
    <!-- Glavna navigacija (Header) -->
    <header
      class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50"
    >
      <div
        class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center"
      >
        <!-- Logotip udruženja -->
        <a
          href="/"
          class="flex items-center gap-3 text-2xl font-black tracking-wider text-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-md group z-50"
        >
          <!-- NOVI LOGO: PNG slika umesto SVG koda -->
          <img
            src="/images/logo.png"
            alt="STEAM INVENT Logo"
            class="w-12 h-12 object-contain group-hover:scale-105 transition-transform duration-300"
          />

          <span
            class="text-slate-900 group-hover:text-indigo-600 transition-colors duration-200"
          >
            STEAM <span class="text-indigo-600">INVENT</span>
          </span>
        </a>

        <!-- DESKTOP NAVIGACIJA -->
        <nav class="hidden md:flex space-x-10 font-semibold">
          <a
            href="/"
            class={pathname === "/"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Početna
          </a>

          <a
            href="/courses"
            class={pathname.startsWith("/courses")
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Programi
          </a>

          <a
            href="/activities"
            class={pathname.startsWith("/activities")
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Aktivnosti
          </a>

          <a
            href="/about"
            class={pathname === "/about"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            O nama
          </a>

          <a
            href="/contact"
            class={pathname === "/contact"
              ? "text-indigo-600"
              : "text-slate-600 hover:text-indigo-600 transition-colors duration-200"}
          >
            Kontakt
          </a>

          <!-- CTA: pridruživanje timu -->
          <a
            href="/contact"
            class="ml-2 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-indigo-500/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-500/30 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
          >
            Postani deo tima
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14M13 6l6 6-6 6"
              />
            </svg>
          </a>
        </nav>

        <!-- DUGME: HAMBURGER TRI CRTICE -->
        <button
          id="menu-btn"
          class="block md:hidden p-2 text-slate-600 hover:text-indigo-600 focus:outline-none z-50"
          aria-label="Meni"
        >
          <svg
            id="menu-icon"
            class="w-7 h-7 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </header>

    <!-- PANEL ZA MOBILNI MENI -->
    <div
      id="steaminvent-mobilni-meni"
      style="display: none; background-color: #ffffff; flex-direction: column;"
      class="fixed inset-0 z-[100] pt-28 px-6 space-y-5 md:hidden"
    >
      <a
        href="/"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/" ? "text-indigo-600" : "text-slate-700"}`}
      >
        Početna
      </a>

      <a
        href="/courses"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname.startsWith("/courses") ? "text-indigo-600" : "text-slate-700"}`}
      >
        Programi
      </a>

      <a
        href="/activities"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname.startsWith("/activities") ? "text-indigo-600" : "text-slate-700"}`}
      >
        Aktivnosti
      </a>

      <a
        href="/about"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/about" ? "text-indigo-600" : "text-slate-700"}`}
      >
        O nama
      </a>

      <a
        href="/contact"
        class={`mobile-link text-xl font-bold py-3 border-b border-slate-100 ${pathname === "/contact" ? "text-indigo-600" : "text-slate-700"}`}
      >
        Kontakt
      </a>

      <!-- CTA: pridruživanje timu -->
      <a
        href="/contact"
        class="mobile-link mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-lg font-bold text-white shadow-md shadow-indigo-500/20 transition-all duration-200 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
      >
        Postani deo tima
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14M13 6l6 6-6 6"
          />
        </svg>
      </a>
    </div>

    <!-- Glavni sadržaj stranica -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Globalno podnožje (Footer) -->
    <Footer />

    <!-- SKRIPT ZA KONTROLU MOBILNOG MENIJA -->
    <script is:inline>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('steaminvent-mobilni-meni');
      const menuIcon = document.getElementById('menu-icon');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function toggleMenu() {
        if (mobileMenu.style.display === 'none') {
          mobileMenu.style.setProperty('display', 'flex', 'important');
          mobileMenu.style.setProperty('background-color', '#ffffff', 'important');
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />';
          document.body.classList.add('overflow-hidden');
        } else {
          mobileMenu.style.display = 'none';
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
          document.body.classList.remove('overflow-hidden');
        }
      }

      menuBtn.addEventListener('click', toggleMenu);

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.style.display = 'none';
          document.body.classList.remove('overflow-hidden');
          menuIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
        });
      });
    </script>
  </body>
</html>