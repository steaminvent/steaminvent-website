---
// src/pages/activities/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { activities } from '../../data/activities';

export async function getStaticPaths() {
  return activities.map((activity) => ({
    params: { slug: activity.slug.trim().toLowerCase() },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { slug } = Astro.params;

const currentSlug = (slug || '').trim().toLowerCase();

const currentActivity = activities.find(
  (item) => item.slug.trim().toLowerCase() === currentSlug
);

if (!currentActivity) {
  throw new Error(`Aktivnost nije pronađena: ${currentSlug}`);
}

const formattedDate = new Date(currentActivity.date).toLocaleDateString('sr-RS', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<MainLayout
  title={currentActivity.seoTitle ?? `${currentActivity.title} | STEAM INVENT`}
  description={currentActivity.excerpt}
>
  <!-- ZAGLAVLJE AKTIVNOSTI -->
  <section class="relative py-16 lg:py-24 bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#312e81_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <div class="max-w-5xl mx-auto px-4 relative z-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
          {currentActivity.category}
        </span>

        <span class="bg-slate-800 text-slate-300 text-xs font-medium px-3 py-1 rounded-full border border-slate-700">
          {formattedDate}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight max-w-4xl">
        {currentActivity.title}
      </h1>

      <p class="mt-4 text-lg sm:text-xl text-slate-300 max-w-3xl font-normal leading-relaxed">
        {currentActivity.excerpt}
      </p>
    </div>
  </section>

  <!-- GLAVNI SADRŽAJ -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-4xl mx-auto space-y-8">

        <!-- Velika slika -->
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm aspect-video w-full">
          <img
            src={currentActivity.image}
            alt={currentActivity.title}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Sadržaj aktivnosti -->
        <article class="bg-white rounded-2xl p-8 lg:p-10 border border-slate-200 shadow-sm">
          <div class="prose prose-slate max-w-none">
            <p class="text-slate-600 text-base lg:text-lg leading-relaxed whitespace-pre-line">
              {currentActivity.content}
            </p>
          </div>
        </article>

        <!-- Povratak na aktivnosti -->
        <div class="flex justify-start">
          <a
            href="/activities"
            class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"
              />
            </svg>
            Nazad na aktivnosti i vesti
          </a>
        </div>

      </div>
    </div>
  </section>
</MainLayout>