---
import MainLayout from '../../layouts/MainLayout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { activities } from '../../data/activities';

// Prikazujemo sve aktivnosti, sortirane od najnovije ka starijima
const allActivities = [...activities].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<MainLayout 
  title="Aktivnosti i Vesti | STEAM INVENT" 
  description="Pratite rad udruženja građana STEAM INVENT kroz vesti, najave otvorenih radionica i inženjerske projekte u Sremskoj Mitrovici."
>
  
  <section class="py-16 lg:py-20 bg-slate-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#312e81_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-5xl mx-auto px-4 relative z-10 text-left">
      <h1 class="text-4xl lg:text-5xl font-black tracking-tight">Aktivnosti i Vesti</h1>
      <p class="mt-4 text-lg text-slate-300 max-w-2xl leading-relaxed">
        Transparentno deljenje znanja i projekata. Ovde možete pratiti sve naše inicijative, radionice ugradnih sistema i napredak članova udruženja.
      </p>
    </div>
  </section>

  <section class="py-16 bg-slate-50 min-h-[50vh]">
    <div class="max-w-5xl mx-auto px-4">
      {allActivities.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allActivities.map((activity) => (
            <ActivityCard activity={activity} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-200">
          <p class="text-slate-500 font-medium">Trenutno nema objavljenih aktivnosti.</p>
        </div>
      )}
    </div>
  </section>

</MainLayout>