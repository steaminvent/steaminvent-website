---
// src/pages/contact.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Kontakt | STEAM INVENT" 
  description="Kontaktirajte udruženje građana STEAM INVENT iz Sremske Mitrovice za informacije o članstvu, radionicama ili B2B saradnji."
>
  
  <!-- ZAGLAVLJE STRANICE -->
  <section class="py-16 bg-gradient-to-b from-indigo-50/50 to-white border-b border-slate-100">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="inline-flex items-center gap-1.5 bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
        Otvoreni za saradnju
      </span>
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl">
        Kontaktirajte nas
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Imate pitanja u vezi sa članstvom i radionicama, projektima za mlade ili želite da ostvarite B2B saradnju sa našim udruženjem? Pišite nam direktno.
      </p>
    </div>
  </section>

  <!-- GLAVNI SADRŽAJ -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
      
      <!-- LEVA KOLONA: INFO PODACI (ŠIRINA 2/5) -->
      <div class="lg:col-span-2 space-y-8">
        <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-8 space-y-6">
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Podaci o udruženju</h2>
          
          <div class="space-y-4">
            <!-- Lokacija -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-slate-900">Sedište</h3>
                <p class="text-sm text-slate-600 mt-0.5">Sremska Mitrovica, Srbija</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-slate-900">Email adresa</h3>
                <p class="text-sm text-slate-600 mt-0.5">info@steaminvent.org</p>
              </div>
            </div>
          </div>

          <hr class="border-slate-200" />

          <!-- Zvanične pravne informacije -->
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Pravne informacije</h3>
            <div class="text-xs text-slate-500 space-y-1.5">
              <p><span class="font-medium text-slate-700">Naziv:</span> Udruženje STEAM INVENT</p>
              <p><span class="font-medium text-slate-700">Sedište:</span> Sremska Mitrovica</p>
              <p><span class="font-medium text-slate-700">Pravni status:</span> Udruženje građana</p>
            </div>
          </div>
        </div>
      </div>

      <!-- DESNA KOLONA: KONTAKT FORMA (ŠIRINA 3/5) -->
      <div class="lg:col-span-3 bg-white border border-slate-200/80 rounded-2xl p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight mb-6">Pošaljite poruku</h2>
        
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          
          <!-- ACCESS TOKEN -->
          <input type="hidden" name="access_key" value="775340c2-4ecf-42e5-b4ef-6c77a8e22fb4" />

          <!-- Honeypot zaštita od botova -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Preusmeravanje nakon slanja -->
          <input type="hidden" name="redirect" value="https://steaminvent.org/thanks" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Ime i prezime</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-colors"
                placeholder="Unesite vaše ime i prezime"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email adresa</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-colors"
                placeholder="primer@domen.rs"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-slate-700 mb-1.5">Svrha upita</label>
            <select 
              id="subject" 
              name="subject" 
              class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 bg-white transition-colors"
            >
              <option value="clanstvo">Članstvo u udruženju i radionice</option>
              <option value="saradnja">Saradnja sa privredom / B2B</option>
              <option value="talenti">Podrška talentima i sekcije</option>
              <option value="opste">Opšta pitanja i informacije</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">Poruka</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-colors"
              placeholder="Napišite detalje vašeg upita, pitanja ili predloga saradnje..."
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full bg-indigo-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-indigo-700 transition-colors duration-200 text-sm shadow-md shadow-indigo-200"
          >
            Pošalji poruku
          </button>
        </form>
      </div>

    </div>
  </section>

</MainLayout>