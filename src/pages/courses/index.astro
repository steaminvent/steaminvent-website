---
// src/pages/courses/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { courses } from '../../data/courses';
---

<MainLayout 
  title="Kursevi | STEAM INVENT" 
  description="Istražite naše praktične programe programiranja, robotike, elektronike i 3D modelovanja za decu i mlade u Sremskoj Mitrovici."
>
  
  <!-- Zaglavlje stranice -->
  <section class="py-16 bg-gradient-to-b from-indigo-50/50 to-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl">
        Naši Edukativni Programi
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Prilagođeni različitim nivoima znanja. Učimo kroz kreiranje sopstvenih hardverskih i softverskih projekata.
      </p>
    </div>
  </section>

  <!-- Grid sa kursevima -->
  <section class="py-20 bg-slate-50/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {courses.map((singleCourse) => (
          <CourseCard course={singleCourse} />
        ))}
      </div>
    </div>
  </section>

</MainLayout>