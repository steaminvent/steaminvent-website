---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { courses } from '../data/courses';
import { initiatives } from '../data/initiatives';
import { activities } from '../data/activities';
import ActivityCard from '../components/ActivityCard.astro';

// SVG putanje za tri ključna tehnološka stuba udruženja (Kategorija A)
const programmingIcon = "M16 18l6-6-6-6M8 6L2 12l6 6"; 
const roboticsIcon = "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"; 
const iotIcon = "M12 2a10 10 0 1 0 10 10H12V2z"; 

// Sortiramo hronološki (najnovije prvo) i uzimamo top 3 za početnu stranu
const latestActivities = [...activities]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const showcaseCourseSlugs = [
  "python-pocetni-nivo",
  "csharp-pocetni-nivo",
  "arduino-robotika-i-iot",
  "3d-stampa-pocetni-nivo",
  "ai-machine-learning",
];

const showcaseCourses = showcaseCourseSlugs
  .map((slug) => courses.find((course) => course.slug === slug))
  .filter((course): course is (typeof courses)[number] => Boolean(course));

// Ponuda udruženja
const offerItems = [
  {
    title: "STEAM kursevi",
    description: "Za decu, mlade i odrasle",
    image: "/images/offer-steam-kursevi.webp",
  },
  {
    title: "Dopunska nastava",
    description: "Podrška učenicima u savladavanju gradiva",
    image: "/images/offer-dopunska-nastava.webp",
  },
  {
    title: "Radionice",
    description: "Praktične radionice i kreativne aktivnosti",
    image: "/images/offer-radionice.webp",
  },
  {
    title: "Projekti",
    description: "Razvoj ideja kroz projekte i inovativna rešenja",
    image: "/images/offer-projekti.webp",
  },
  {
    title: "Takmičenja",
    description: "Priprema za takmičenja",
    image: "/images/offer-takmicenja.webp",
  },
  {
    title: "Saradnja sa kompanijama",
    description: "Obuke i treninzi po meri industrije",
    image: "/images/offer-saradnja.webp",
  },
];

---

<MainLayout
  title="STEAM INVENT | STEAM kursevi, programiranje, robotika i AI"
  description="STEAM INVENT iz Sremske Mitrovice razvija znanje i praktične veštine kroz STEAM kurseve, programiranje, robotiku, 3D modelovanje, AI, radionice i projekte za decu, mlade i odrasle."
>
  
    <!-- HERO SEKCIJA -->
<section class="relative overflow-hidden bg-[#001a33] text-white">

  <div class="pointer-events-none absolute -left-32 -top-32 h-80 w-80 rounded-full bg-violet-600/20 blur-3xl"></div>

  <div class="pointer-events-none absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>

  <!-- DESKTOP -->
  <div class="relative hidden xl:block">

    <picture>
      <source
        media="(min-width: 1280px)"
        srcset="/images/hero-background.webp"
        type="image/webp"
      />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        alt=""
        aria-hidden="true"
        width="1956"
        height="804"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full"
      />
    </picture>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#001a33]/75 via-[#001a33]/30 to-transparent"
    ></div>

    <div class="absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-7xl px-8 xl:px-12">
        <div class="max-w-[610px]">

          <p
            class="text-[10px] font-semibold uppercase tracking-[0.20em] text-cyan-200 xl:text-xs"
          >
            Udruženje za promociju STEAM disciplina i inovacija
          </p>

          <div
            class="mt-3 flex items-center text-[4rem] font-black leading-[0.9] tracking-[-0.055em] 2xl:text-[4.7rem]"
          >
            <span class="text-white">
              STEAM
            </span>

            <span
              class="ml-5 bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent"
            >
              INVENT
            </span>
          </div>

          <h1
            class="mt-5 text-[2rem] font-extrabold tracking-tight text-white 2xl:text-[2.2rem]"
          >
            Znanje. Kreativnost. Inovacija.
          </h1>

          <p
            class="mt-4 max-w-xl text-[15px] leading-6 text-slate-200 2xl:text-base 2xl:leading-7"
          >
            Kroz praktičan rad, savremene tehnologije i timski duh
            inspirišemo decu i mlade da istražuju, stvaraju i oblikuju
            bolju budućnost.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">

            <a
              href="/courses"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-950/30 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 focus:ring-offset-[#001a33]"
            >
              Istraži naše programe
              <span aria-hidden="true" class="text-lg leading-none">
                →
              </span>
            </a>

            <a
              href="/about"
              class="inline-flex items-center justify-center rounded-xl border border-white/70 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:border-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#001a33]"
            >
              Saznaj više o nama
            </a>

          </div>

          <div class="mt-8 w-full max-w-[390px]">

            <img
              src="/images/hero-steam-icons.webp"
              alt="Science, Technology, Engineering, Art i Mathematics"
              width="1600"
              height="300"
              class="block h-auto w-full object-contain object-left"
              decoding="async"
            />

          </div>

        </div>
      </div>
    </div>

    <div
      class="absolute right-[4%] top-[11%] z-10 max-w-[180px] text-right"
    >
      <p
        class="font-[cursive] text-3xl leading-[1.05] text-white drop-shadow-lg 2xl:text-[2.15rem]"
      >
        Mali
        <br />
        koraci
        <br />
        velike
        <br />
        ideje!
      </p>

      <div
        class="ml-auto mt-3 h-1.5 w-24 rotate-[-7deg] rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-500"
      ></div>
    </div>

  </div>

  <!-- TABLET / MOBILE -->
<div class="block xl:hidden">

  <div
    class="relative z-10 overflow-hidden bg-gradient-to-br from-[#001a33] via-[#071f45] to-[#24105a]"
  >

    <div class="px-5 py-10 sm:px-8 sm:py-14">

      <div class="mx-auto max-w-2xl text-center">

        <p
          class="text-[10px] font-semibold uppercase tracking-[0.16em] text-cyan-200 sm:text-xs"
        >
          Udruženje za promociju STEAM disciplina i inovacija
        </p>

        <div
          class="mt-3 flex items-center justify-center text-[3rem] font-black leading-[0.9] tracking-[-0.055em] sm:text-6xl"
        >
          <span class="text-white">
            STEAM
          </span>

          <span
            class="ml-5 bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent"
          >
            INVENT
          </span>
        </div>

        <h1
          class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-3xl"
        >
          Znanje. Kreativnost. Inovacija.
        </h1>

        <p
          class="mx-auto mt-4 max-w-xl text-sm leading-6 text-slate-200 sm:text-base sm:leading-7"
        >
          Kroz praktičan rad, savremene tehnologije i timski duh
          inspirišemo decu i mlade da istražuju, stvaraju i oblikuju
          bolju budućnost.
        </p>

        <div
          class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
        >

          <a
            href="/courses"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-violet-950/30 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 focus:ring-offset-[#071f45]"
          >
            Istraži naše programe
            <span aria-hidden="true" class="text-lg leading-none">
              →
            </span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center justify-center rounded-xl border border-white/70 bg-white/5 px-5 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#071f45]"
          >
            Saznaj više o nama
          </a>

        </div>

        <div class="mx-auto mt-8 w-full max-w-[420px] sm:mt-9">
          <img
            src="/images/hero-steam-icons.webp"
            alt="Science, Technology, Engineering, Art i Mathematics"
            width="1600"
            height="300"
            class="block h-auto w-full object-contain"
            decoding="async"
          />
        </div>

      </div>

    </div>

  </div>

  <!-- Mobilna fotografija -->
  <div class="relative overflow-hidden bg-[#001a33]">

    <img
      src="/images/hero-background-mobile.webp"
      alt="Učenici tokom praktičnog rada na robotskom projektu"
      width="1196"
      height="804"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block h-auto w-full"
    />

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#001a33]/45 to-transparent"
    ></div>

    <div
      class="absolute right-5 top-5 z-10 max-w-[125px] text-right sm:right-8 sm:top-8 sm:max-w-[160px]"
    >
      <p
        class="font-[cursive] text-2xl leading-[1.05] text-white drop-shadow-lg sm:text-3xl"
      >
        Mali
        <br />
        koraci
        <br />
        velike
        <br />
        ideje!
      </p>

    </div>

  </div>

</div>

</section>


  <!-- NAŠA PONUDA -->
  <section class="relative overflow-hidden bg-[#f9fbff] py-16 sm:py-20 lg:py-24">
    <div class="pointer-events-none absolute -left-24 top-10 h-64 w-64 rounded-full bg-violet-300/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-4xl text-center sm:mb-12 lg:mb-14">
        <p class="text-xs font-bold uppercase tracking-[0.20em] text-violet-700">
          Naša ponuda
        </p>

        <h2 class="mt-3 text-3xl font-black tracking-tight text-[#09224a] sm:text-4xl lg:text-5xl">
          Od radoznalosti do stvarnih veština
        </h2>

        <p class="mx-auto mt-4 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base sm:leading-7">
          STEAM INVENT okuplja decu, mlade, profesore i stručnjake kroz programe,
          radionice i projekte koji povezuju znanje, kreativnost i tehnologiju.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        {offerItems.map((item) => (
          <div
            class="group flex min-h-[310px] flex-col items-center rounded-3xl border border-slate-200/80 bg-white px-5 py-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl"
          >
            <div class="flex h-[145px] w-full items-center justify-center overflow-hidden rounded-2xl">
              <img
                src={item.image}
                alt={item.title}
                width="1000"
                height="834"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>

            <h3 class="mt-5 text-[1.05rem] font-black leading-tight text-[#09224a]">
              {item.title}
            </h3>

            <p class="mt-3 max-w-[220px] text-sm leading-5 text-slate-600">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STEAM INVENT DRVO -->
<section class="relative overflow-hidden bg-white py-12 sm:py-16 md:py-20 lg:py-24">

  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[80%] w-[80%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-r from-violet-500/10 via-cyan-400/10 to-violet-500/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8">

    <div class="mx-auto w-full max-w-[1100px]">

      <img
        src="/images/steam-drvo-home.webp"
        alt="STEAM INVENT — Drvo znanja"
        width="1536"
        height="1536"
        loading="lazy"
        decoding="async"
        class="mx-auto block h-auto w-full object-contain drop-shadow-[0_20px_45px_rgba(32,51,105,0.18)] transition-transform duration-500 hover:scale-[1.01]"
      />

    </div>

  </div>

</section>

<!-- NAŠI PROGRAMI -->
<section class="relative overflow-hidden bg-white py-16 sm:py-20 lg:py-24">

  <div
    class="pointer-events-none absolute -left-32 top-20 h-72 w-72 rounded-full bg-violet-200/25 blur-3xl"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -right-32 bottom-10 h-80 w-80 rounded-full bg-cyan-200/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1450px] px-5 sm:px-8 lg:px-10">

    <div
      class="grid gap-10 lg:grid-cols-[0.65fr_2.35fr] lg:items-center xl:gap-14"
    >

      <div class="text-center lg:text-left">
        <p
          class="text-xs font-bold uppercase tracking-[0.18em] text-violet-700"
        >
          Naši programi
        </p>

        <h2
          class="mt-3 text-3xl font-black tracking-tight text-[#09224a] sm:text-4xl"
        >
          Nauči.
          <br class="hidden lg:block" />
          Primeni.
          <br class="hidden lg:block" />
          <span
            class="bg-gradient-to-r from-violet-700 via-purple-700 to-indigo-600 bg-clip-text text-transparent"
          >
            Napravi.
          </span>
        </h2>

        <p
          class="mx-auto mt-5 max-w-md text-sm leading-6 text-slate-600 sm:text-base sm:leading-7 lg:mx-0"
        >
          Od programiranja i robotike, preko 3D modelovanja i veštačke
          inteligencije, do elektronike i mnogih drugih oblasti. Naši
          programi su praktični, moderni i prilagođeni različitim
          uzrastima i nivoima znanja.
        </p>

        <a
          href="/courses"
          class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-700 to-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-900/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl"
        >
          Pogledaj sve programe
          <span aria-hidden="true" class="text-lg leading-none">→</span>
        </a>
      </div>

      <div
        class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
      >

        {showcaseCourses.map((course) => (
          <a
            href={`/courses/${course.slug}`}
            class="group flex min-h-[300px] flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl"
          >

            <div class="relative aspect-[1.35/1] overflow-hidden bg-slate-100">
              <img
                src={course.image}
                alt={course.title}
                width="900"
                height="780"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              <div
                class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/45 to-transparent"
                aria-hidden="true"
              ></div>

              <span
                class="absolute bottom-3 left-3 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold text-violet-700 shadow-sm"
              >
                {course.difficulty}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5">

              <h3
                class="text-base font-black leading-tight text-[#09224a] sm:text-[17px]"
              >
                {course.title}
              </h3>

              <div class="mt-auto flex items-center justify-end pt-6">

                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-lg font-semibold text-indigo-600 transition-all duration-300 group-hover:translate-x-1 group-hover:bg-indigo-600 group-hover:text-white"
                  aria-hidden="true"
                >
                  →
                </span>

              </div>
            </div>

          </a>
        ))}

      </div>
    </div>
  </div>
</section>


  <!-- AKTIVNOSTI -->
  <section class="relative overflow-hidden bg-[#fbfcff] py-16 sm:py-20 lg:py-24">

    <div
      class="pointer-events-none absolute -left-24 bottom-10 h-72 w-72 rounded-full bg-cyan-200/15 blur-3xl"
      aria-hidden="true"
    ></div>

    <div
      class="pointer-events-none absolute -right-24 top-10 h-80 w-80 rounded-full bg-violet-200/20 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-[1450px] px-5 sm:px-8 lg:px-10">

      <div
        class="grid gap-10 lg:grid-cols-[0.65fr_2.35fr] lg:items-center xl:gap-14"
      >

        <div class="text-center lg:text-left">

          <p
            class="text-xs font-bold uppercase tracking-[0.18em] text-violet-700"
          >
            Aktivnosti
          </p>

          <h2
            class="mt-3 text-3xl font-black tracking-tight text-[#09224a] sm:text-4xl"
          >
            Šta je novo u STEAM INVENT-u?
          </h2>

          <p
            class="mx-auto mt-5 max-w-md text-sm leading-6 text-slate-600 sm:text-base sm:leading-7 lg:mx-0"
          >
            Pratite naše radionice, događaje, projekte i uspehe naših
            polaznika i članova udruženja.
          </p>

          <a
            href="/activities"
            class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-700 to-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-900/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl"
          >
            Pogledaj sve aktivnosti
            <span aria-hidden="true" class="text-lg leading-none">→</span>
          </a>

        </div>


        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">

          {latestActivities.map((activity) => {
            const formattedDate = new Date(activity.date).toLocaleDateString(
              "sr-RS",
              {
                day: "numeric",
                month: "long",
                year: "numeric",
              }
            );

            return (
              <article
                class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl"
              >

                <a
                  href={`/activities/${activity.slug}`}
                  class="block"
                >

                  <div class="relative aspect-video overflow-hidden bg-slate-100">
                    <img
                      src={activity.image}
                      alt={activity.title}
                      width="900"
                      height="506"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />

                    <span
                      class="absolute left-4 top-4 rounded-md border border-white/70 bg-white/95 px-2.5 py-1 text-[10px] font-bold text-indigo-700 shadow-sm"
                    >
                      {formattedDate}
                    </span>

                  </div>

                  <div class="flex min-h-[160px] flex-col p-5">

                    <p
                      class="text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700"
                    >
                      {activity.category}
                    </p>

                    <h3
                      class="mt-2 text-base font-black leading-snug text-[#09224a] transition-colors duration-200 group-hover:text-indigo-600"
                    >
                      {activity.title}
                    </h3>

                    <div class="mt-auto flex justify-end pt-6">

                      <span
                        class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50 text-lg font-semibold text-indigo-600 transition-all duration-300 group-hover:translate-x-1 group-hover:bg-indigo-600 group-hover:text-white"
                        aria-hidden="true"
                      >
                        →
                      </span>

                    </div>

                  </div>

                </a>

              </article>
            );
          })}

        </div>
      </div>
    </div>
  </section>

  <!-- PRIJATELJI I PARTNERI -->
  <section class="relative overflow-hidden bg-white py-14 sm:py-16 lg:py-20">

    <div
      class="pointer-events-none absolute left-1/2 top-0 h-64 w-96 -translate-x-1/2 rounded-full bg-cyan-200/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-5xl px-5 sm:px-6 lg:px-8">

      <div class="text-center">

        <p
          class="text-xs font-bold uppercase tracking-[0.18em] text-violet-700"
        >
          Prijatelji i partneri
        </p>

        <h2
          class="mt-3 text-2xl font-black tracking-tight text-[#09224a] sm:text-3xl lg:text-4xl"
        >
          <span class="block">
            Zajedno gradimo
          </span>

          <span
            class="mt-2 block pb-1 bg-gradient-to-r from-violet-700 via-purple-700 to-indigo-600 bg-clip-text text-transparent"
          >
            bolje ideje
          </span>
        </h2>

        <p
          class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base sm:leading-7"
