---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { initiatives } from '../data/initiatives';
import { activities } from '../data/activities';
import ActivityCard from '../components/ActivityCard.astro';

// SVG putanje za tri ključna tehnološka stuba udruženja (Kategorija A)
const programmingIcon = "M16 18l6-6-6-6M8 6L2 12l6 6"; 
const roboticsIcon = "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"; 
const iotIcon = "M12 2a10 10 0 1 0 10 10H12V2z"; 

// Sortiramo hronološki (najnovije prvo) i uzimamo top 3 za početnu stranu
const latestActivities = [...activities]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Ponuda udruženja
const offerItems = [
  {
    title: "STEAM kursevi",
    description: "Za decu, mlade i odrasle",
    image: "/images/offer-steam-kursevi.png",
  },
  {
    title: "Dopunska nastava",
    description: "Podrška učenicima u savladavanju gradiva",
    image: "/images/offer-dopunska-nastava.png",
  },
  {
    title: "Radionice",
    description: "Praktične radionice i kreativne aktivnosti",
    image: "/images/offer-radionice.png",
  },
  {
    title: "Projekti",
    description: "Razvoj ideja kroz projekte i inovativna rešenja",
    image: "/images/offer-projekti.png",
  },
  {
    title: "Takmičenja",
    description: "Priprema za takmičenja",
    image: "/images/offer-takmicenja.png",
  },
  {
    title: "Saradnja sa kompanijama",
    description: "Obuke i treninzi po meri industrije",
    image: "/images/offer-saradnja.png",
  },
];

---

<MainLayout title="Početna | STEAM INVENT">
  
    <!-- HERO SEKCIJA -->
<section class="relative overflow-hidden bg-[#001a33] text-white">

  <div class="pointer-events-none absolute -left-32 -top-32 h-80 w-80 rounded-full bg-violet-600/20 blur-3xl"></div>

  <div class="pointer-events-none absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>

  <!-- DESKTOP -->
  <div class="relative hidden xl:block">

    <img
      src="/images/hero-background.png"
      alt=""
      aria-hidden="true"
      width="1956"
      height="804"
      fetchpriority="high"
      decoding="async"
      class="block h-auto w-full"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#001a33]/75 via-[#001a33]/30 to-transparent"
    ></div>

    <div class="absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-7xl px-8 xl:px-12">
        <div class="max-w-[610px]">

          <p
            class="text-[10px] font-semibold uppercase tracking-[0.20em] text-cyan-200 xl:text-xs"
          >
            Udruženje za promociju STEAM disciplina i inovacija
          </p>

          <div
            class="mt-3 flex items-center text-[4rem] font-black leading-[0.9] tracking-[-0.055em] 2xl:text-[4.7rem]"
          >
            <span class="text-white">
              STEAM
            </span>

            <span
              class="ml-5 bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent"
            >
              INVENT
            </span>
          </div>

          <h1
            class="mt-5 text-[2rem] font-extrabold tracking-tight text-white 2xl:text-[2.2rem]"
          >
            Znanje. Kreativnost. Inovacija.
          </h1>

          <p
            class="mt-4 max-w-xl text-[15px] leading-6 text-slate-200 2xl:text-base 2xl:leading-7"
          >
            Kroz praktičan rad, savremene tehnologije i timski duh
            inspirišemo decu i mlade da istražuju, stvaraju i oblikuju
            bolju budućnost.
          </p>

          <div class="mt-6 flex flex-wrap gap-3">

            <a
              href="/courses"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-950/30 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 focus:ring-offset-[#001a33]"
            >
              Istraži naše programe
              <span aria-hidden="true" class="text-lg leading-none">
                →
              </span>
            </a>

            <a
              href="/about"
              class="inline-flex items-center justify-center rounded-xl border border-white/70 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:border-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#001a33]"
            >
              Saznaj više o nama
            </a>

          </div>

          <div class="mt-8 w-full max-w-[390px]">

            <img
              src="/images/hero-steam-icons.png"
              alt="Science, Technology, Engineering, Art i Mathematics"
              width="1600"
              height="300"
              class="block h-auto w-full object-contain object-left"
              decoding="async"
            />

          </div>

        </div>
      </div>
    </div>

    <div
      class="absolute right-[4%] top-[11%] z-10 max-w-[180px] text-right"
    >
      <p
        class="font-[cursive] text-3xl leading-[1.05] text-white drop-shadow-lg 2xl:text-[2.15rem]"
      >
        Mali
        <br />
        koraci
        <br />
        velike
        <br />
        ideje!
      </p>

      <div
        class="ml-auto mt-3 h-1.5 w-24 rotate-[-7deg] rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-500"
      ></div>
    </div>

  </div>

  <!-- TABLET / MOBILE -->
<div class="block xl:hidden">

  <div
    class="relative z-10 overflow-hidden bg-gradient-to-br from-[#001a33] via-[#071f45] to-[#24105a]"
  >

    <div class="px-5 py-10 sm:px-8 sm:py-14">

      <div class="mx-auto max-w-2xl text-center">

        <p
          class="text-[10px] font-semibold uppercase tracking-[0.16em] text-cyan-200 sm:text-xs"
        >
          Udruženje za promociju STEAM disciplina i inovacija
        </p>

        <div
          class="mt-3 flex items-center justify-center text-[3rem] font-black leading-[0.9] tracking-[-0.055em] sm:text-6xl"
        >
          <span class="text-white">
            STEAM
          </span>

          <span
            class="ml-5 bg-gradient-to-r from-violet-400 via-purple-400 to-indigo-400 bg-clip-text text-transparent"
          >
            INVENT
          </span>
        </div>

        <h1
          class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-3xl"
        >
          Znanje. Kreativnost. Inovacija.
        </h1>

        <p
          class="mx-auto mt-4 max-w-xl text-sm leading-6 text-slate-200 sm:text-base sm:leading-7"
        >
          Kroz praktičan rad, savremene tehnologije i timski duh
          inspirišemo decu i mlade da istražuju, stvaraju i oblikuju
          bolju budućnost.
        </p>

        <div
          class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap"
        >

          <a
            href="/courses"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-violet-950/30 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-violet-300 focus:ring-offset-2 focus:ring-offset-[#071f45]"
          >
            Istraži naše programe
            <span aria-hidden="true" class="text-lg leading-none">
              →
            </span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center justify-center rounded-xl border border-white/70 bg-white/5 px-5 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#071f45]"
          >
            Saznaj više o nama
          </a>

        </div>

        <div class="mx-auto mt-8 w-full max-w-[420px] sm:mt-9">
          <img
            src="/images/hero-steam-icons.png"
            alt="Science, Technology, Engineering, Art i Mathematics"
            width="1600"
            height="300"
            class="block h-auto w-full object-contain"
            decoding="async"
          />
        </div>

      </div>

    </div>

  </div>

  <!-- Mobilna fotografija -->
  <div class="relative overflow-hidden bg-[#001a33]">

    <img
      src="/images/hero-background-mobile.png"
      alt="Učenici tokom praktičnog rada na robotskom projektu"
      width="1196"
      height="804"
      loading="eager"
      decoding="async"
      class="block h-auto w-full"
    />

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#001a33]/45 to-transparent"
    ></div>

    <div
      class="absolute right-5 top-5 z-10 max-w-[125px] text-right sm:right-8 sm:top-8 sm:max-w-[160px]"
    >
      <p
        class="font-[cursive] text-2xl leading-[1.05] text-white drop-shadow-lg sm:text-3xl"
      >
        Mali
        <br />
        koraci
        <br />
        velike
        <br />
        ideje!
      </p>

    </div>

  </div>

</div>

</section>


  <!-- NAŠA PONUDA -->
  <section class="relative overflow-hidden bg-[#f9fbff] py-16 sm:py-20 lg:py-24">
    <div class="pointer-events-none absolute -left-24 top-10 h-64 w-64 rounded-full bg-violet-300/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-4xl text-center sm:mb-12 lg:mb-14">
        <p class="text-xs font-bold uppercase tracking-[0.20em] text-violet-700">
          Naša ponuda
        </p>

        <h2 class="mt-3 text-3xl font-black tracking-tight text-[#09224a] sm:text-4xl lg:text-5xl">
          Od radoznalosti do stvarnih veština
        </h2>

        <p class="mx-auto mt-4 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base sm:leading-7">
          STEAM INVENT okuplja decu, mlade, profesore i stručnjake kroz programe,
          radionice i projekte koji povezuju znanje, kreativnost i tehnologiju.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        {offerItems.map((item) => (
          <div
            class="group flex min-h-[310px] flex-col items-center rounded-3xl border border-slate-200/80 bg-white px-5 py-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl"
          >
            <div class="flex h-[145px] w-full items-center justify-center overflow-hidden rounded-2xl">
              <img
                src={item.image}
                alt={item.title}
                width="1000"
                height="834"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>

            <h3 class="mt-5 text-[1.05rem] font-black leading-tight text-[#09224a]">
              {item.title}
            </h3>

            <p class="mt-3 max-w-[220px] text-sm leading-5 text-slate-600">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STEAM INVENT DRVO -->
<section class="relative overflow-hidden bg-white py-12 sm:py-16 md:py-20 lg:py-24">

  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[80%] w-[80%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-r from-violet-500/10 via-cyan-400/10 to-violet-500/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-7xl px-3 sm:px-6 lg:px-8">

    <div class="mx-auto w-full max-w-[1100px]">

      <img
        src="/images/steam-drvo-home.png"
        alt="STEAM INVENT — Drvo znanja"
        width="1536"
        height="1536"
        loading="lazy"
        decoding="async"
        class="mx-auto block h-auto w-full object-contain drop-shadow-[0_20px_45px_rgba(32,51,105,0.18)] transition-transform duration-500 hover:scale-[1.01]"
      />

    </div>

  </div>

</section>

  <!-- KATEGORIJA B: SEKCIJA ZA AKTIVNOSTI I INICIJATIVE UDRUŽENJA -->
  <section class="py-24 bg-slate-300/80 text-slate-900 sm:rounded-3xl sm:mx-4 my-8 border-y sm:border border-slate-400/40 shadow-inner">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-indigo-800 text-xs font-bold uppercase tracking-wider bg-white px-3 py-1 rounded-full shadow-sm">
          Širi društveni uticaj
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight mt-3">
          Inicijative i društvene aktivnosti
        </h2>
        <p class="mt-4 text-slate-800 text-lg font-medium">
          Kao udruženje građana, naš cilj je da aktivno radimo na razvoju lokalne zajednice, podršci mladim talentima i digitalizaciji privrede.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {initiatives.map((item) => (
          <div class="bg-white border border-slate-200/60 p-8 rounded-2xl flex flex-col justify-between hover:border-indigo-500/50 hover:shadow-lg transition-all duration-300 shadow-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 shadow-sm">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.iconPath}></path>
                </svg>
              </div>
              
              <h3 class="text-xl font-bold text-slate-950 mb-3">
                {item.title}
              </h3>
              <p class="text-slate-700 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SEKCIJA: AKTUELNOSTI -->
  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-5xl mx-auto px-4">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div class="text-left">
          <h2 class="text-3xl font-black text-slate-900 tracking-tight">Aktuelnosti udruženja</h2>
          <p class="text-slate-500 mt-2 max-w-xl">Predstavljamo vam sve novosti kod nas, kako izgledaju naše radionice i rezultate koje postižemo zajedno sa našim članovima.</p>
        </div>
        
        <a 
          href="/activities" 
          class="inline-flex items-center justify-center font-bold text-sm text-indigo-600 bg-indigo-50 hover:bg-indigo-100/80 px-5 py-2.5 rounded-xl transition-colors whitespace-nowrap"
        >
          Pogledaj sve aktivnosti
        </a>
      </div>

      <!-- Dinamička mreža kartica -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestActivities.map((activity) => (
          <ActivityCard activity={activity} />
        ))}
      </div>

    </div>
  </section>

  <!-- SEKCIJA: PARTNERI (Izvorna boja + fukus/hover efekat) -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-8">Prijatelji i partneri udruženja</h3>
      
      <div class="flex justify-center items-center gap-8 flex-wrap">
        <!-- ALBO Energy Logo -->
        <a href="https://www.albo-energy.com/" target="_blank" rel="noopener noreferrer" class="group block p-4" aria-label="ALBO Energy">
          <img 
            src="/images/alboEnergy-bg-free.png" 
            alt="ALBO Energy Logo" 
            class="h-16 md:h-20 w-auto object-contain opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300 drop-shadow-sm group-hover:drop-shadow-md"
          />
        </a>
      </div>
    </div>
  </section>

</MainLayout>